############################################
# Copy this file to terraform.tfvars and fill in the blanks.
# terraform.tfvars is gitignored — never commit secrets.
############################################

env                = "dev"
aws_region         = "ap-northeast-1"
chime_media_region = "ap-northeast-1"

# RDS master password. Must be 8+ chars.
rds_master_password = "CHANGE_ME_STRONG_PASSWORD"

# Backend container image. Push an image to ECR first, then paste its URI here.
# Until a real image exists, you can bootstrap with a stub like
# "public.ecr.aws/amazonlinux/amazonlinux:latest" just to let terraform plan.
backend_container_image = "123456789012.dkr.ecr.ap-northeast-1.amazonaws.com/dolphin-dev/backend:latest"

# Cognito test user (optional — set create_cognito_test_user = true to create).
create_cognito_test_user             = false
cognito_test_user_email              = ""
cognito_test_user_temporary_password = ""

# ML EC2 host.
# 1. Create an EC2 key pair in the AWS console first, then put its name here.
# 2. Restrict admin_cidrs to teammate IPs (/32).
ml_instance_type  = "g5.2xlarge"
ml_key_name       = "dolphin-dev-ml"
ml_admin_cidrs    = ["203.0.113.10/32"]
ml_s3_bucket_arns = []
